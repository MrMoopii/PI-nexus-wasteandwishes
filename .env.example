# Salin file ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
#
# JANGAN pernah menaruh nilai asli di file ini. File ini ikut ke GitHub.
# .env.local sudah di-ignore oleh Git dan tidak boleh di-commit.
# Nilai rahasia dibagikan lewat pesan privat, bukan lewat grup publik atau GitHub.

# --- Database (PostgreSQL di Neon) ---
# Koneksi untuk aplikasi (pooled).
# Koneksi langsung (direct, tanpa pooling), dipakai untuk migrasi.
DIRECT_URL=

# --- Autentikasi (Auth.js) ---
# Buat nilai acak yang panjang untuk tiap lingkungan.
AUTH_SECRET=

# --- Pembayaran (Midtrans / Xendit) ---
# Pakai kunci SANDBOX untuk pengembangan. Kunci produksi hanya di Vercel.
PAYMENT_SERVER_KEY=
PAYMENT_CLIENT_KEY=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET="